\PYG{+w}{    }\PYG{n}{p0}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mf}{1.0}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{n}{part\PYGZus{}sum}\PYG{+w}{ }\PYG{c}{\PYGZsh{}p0 \PYGZhy{} константа, одна на все}

