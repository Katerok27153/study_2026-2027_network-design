\PYG{c}{\PYGZsh{}\PYGZsh{} 3.1 Стационарное распределение вероятностей состояний системы p(n1, n2)}
\PYG{k}{function}\PYG{+w}{ }\PYG{n}{stationary\PYGZus{}probability}\PYG{p}{(}\PYG{n}{a1}\PYG{o}{::}\PYG{k+kt}{Float64}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{a2}\PYG{o}{::}\PYG{k+kt}{Float64}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{n1}\PYG{o}{::}\PYG{k+kt}{Int}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{n2}\PYG{o}{::}\PYG{k+kt}{Int}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{n1\PYGZus{}max}\PYG{o}{::}\PYG{k+kt}{Int}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{n2\PYGZus{}max}\PYG{o}{::}\PYG{k+kt}{Int}\PYG{p}{)}
\PYG{+w}{    }\PYG{n}{n\PYGZus{}sum}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{n1}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{n2}

\PYG{+w}{    }\PYG{n}{part\PYGZus{}sum}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mf}{0.0}

\PYG{+w}{    }\PYG{c}{\PYGZsh{} сумма p(0,0): пробегаем все состояния сетки (i, j)}
\PYG{+w}{    }\PYG{c}{\PYGZsh{} границы суммирования: i от 0 до n1\PYGZus{}max, j от 0 до n2\PYGZus{}max}
\PYG{+w}{    }\PYG{k}{for}\PYG{+w}{ }\PYG{n}{i}\PYG{+w}{ }\PYG{k}{in}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{o}{:}\PYG{n}{n1\PYGZus{}max}
\PYG{+w}{        }\PYG{k}{for}\PYG{+w}{ }\PYG{n}{j}\PYG{+w}{ }\PYG{k}{in}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{o}{:}\PYG{n}{n2\PYGZus{}max}
\PYG{+w}{            }\PYG{n}{part\PYGZus{}sum}\PYG{+w}{ }\PYG{o}{+=}\PYG{+w}{ }\PYG{n}{factorial}\PYG{p}{(}\PYG{n}{big}\PYG{p}{(}\PYG{n}{i}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{j}\PYG{p}{))}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{p}{((}\PYG{n}{a1}\PYG{o}{\PYGZca{}}\PYG{n}{i}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{a2}\PYG{o}{\PYGZca{}}\PYG{n}{j}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{factorial}\PYG{p}{(}\PYG{n}{big}\PYG{p}{(}\PYG{n}{i}\PYG{p}{))}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{factorial}\PYG{p}{(}\PYG{n}{big}\PYG{p}{(}\PYG{n}{j}\PYG{p}{))))}

\PYG{+w}{        }\PYG{k}{end}
\PYG{+w}{    }\PYG{k}{end}

\PYG{+w}{    }\PYG{n}{p0}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mf}{1.0}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{n}{part\PYGZus{}sum}\PYG{+w}{ }\PYG{c}{\PYGZsh{} p0 = p(0,0) \PYGZhy{} константа, общая для всех состояний}

\PYG{+w}{    }\PYG{c}{\PYGZsh{} считаем p(n1, n2)}
\PYG{+w}{    }\PYG{n}{p}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{p0}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{factorial}\PYG{p}{(}\PYG{n}{big}\PYG{p}{(}\PYG{n}{n\PYGZus{}sum}\PYG{p}{))}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{p}{((}\PYG{n}{a1}\PYG{o}{\PYGZca{}}\PYG{n}{n1}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{a2}\PYG{o}{\PYGZca{}}\PYG{n}{n2}\PYG{p}{)}\PYG{+w}{ }\PYG{o}{/}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{factorial}\PYG{p}{(}\PYG{n}{big}\PYG{p}{(}\PYG{n}{n1}\PYG{p}{))}\PYG{+w}{ }\PYG{o}{*}\PYG{+w}{ }\PYG{n}{factorial}\PYG{p}{(}\PYG{n}{big}\PYG{p}{(}\PYG{n}{n2}\PYG{p}{))))}

\PYG{+w}{    }\PYG{k}{return}\PYG{+w}{ }\PYG{n}{p}
\PYG{k}{end}

